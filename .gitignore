# PhotoArchive — conservative safeguards for a PUBLIC repository.
# Working archive files belong outside Git (for example, in Dropbox).
# Ignore rules do not remove files already tracked by Git or erase Git history.
# Review git status and staged diffs before every commit; never force-add private data.

# -----------------------------------------------------------------------------
# Original archival photographs, scans, video, audio, and document captures.
# Case-insensitive character classes also cover uppercase camera/scanner suffixes.
# -----------------------------------------------------------------------------
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[jJ][pP][eE]
*.[pP][nN][gG]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[gG][iI][fF]
*.[bB][mM][pP]
*.[wW][eE][bB][pP]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[aA][vV][iI][fF]
*.[dD][nN][gG]
*.[rR][aA][wW]
*.[cC][rR]2
*.[cC][rR]3
*.[nN][eE][fF]
*.[aA][rR][wW]
*.[oO][rR][fF]
*.[rR][wW]2
*.[rR][aA][fF]
*.[pP][sS][dD]
*.[pP][sS][bB]
*.[pP][dD][fF]
*.[mM][pP]4
*.[mM][oO][vV]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[mM][4][vV]
*.[wW][aA][vV]
*.[mM][pP]3
*.[fF][lL][aA][cC]
*.[mM]4[aA]
*.[aA][aA][cC]
*.[oO][gG][gG]
*.[xX][mM][pP]
*.[aA][aA][eE]

# Archive, derivative, and private working trees, at any depth.
# Use contents patterns, not excluded parent directories, so fixture opt-ins work.
[Aa]rchive/**
[Aa]rchives/**
[Pp]hotos/**
[Ss]cans/**
[Oo]riginals/**
[Nn]egatives/**
[Dd]erivatives/**
[Tt]humbnails/**
[Pp]reviews/**
[Oo][Cc][Rr]/**
[Dd]ropbox/**
[Pp]rivate/**
[Pp]ersonal/**
[Ff]amily/**
[Ss]ensitive/**
[Dd]ata/**
[Ii]mports/**
[Ww]ork/**
[Ll]ocal/**

# -----------------------------------------------------------------------------
# Family records, bulk metadata, spreadsheets, genealogy, and serialized data.
# JSON/YAML/XML are not globally excluded: schemas and source config use them.
# Keep private JSON/YAML/XML in the private/data/local trees above.
# -----------------------------------------------------------------------------
*.[cC][sS][vV]
*.[tT][sS][vV]
*.[jJ][sS][oO][nN][lL]
*.[nN][dD][jJ][sS][oO][nN]
*.[xX][lL][sS]
*.[xX][lL][sS][xX]
*.[xX][lL][sS][mM]
*.[oO][dD][sS]
*.[gG][eE][dD]
*.[gG][eE][dD][cC][oO][mM]
*.[vV][cC][fF]
*.[pP][aA][rR][qQ][uU][eE][tT]
*.[fF][eE][aA][tT][hH][eE][rR]
*.[pP][kK][lL]
*.[pP][iI][cC][kK][lL][eE]

# Deliberately maintained controlled vocabularies may use tabular formats.
# These root directories must contain public, reviewed content only.
!/vocabularies/**
!/controlled-vocabularies/**
!/schema/vocabularies/**
!/schemas/vocabularies/**

# -----------------------------------------------------------------------------
# Metabase/application state, databases, journals, locks, and database dumps.
# SQL source/migrations stay trackable; place SQL dumps in backups/ or exports/.
# -----------------------------------------------------------------------------
